---
layout: layouts/base.njk
nav: resources
pagination:
  data: collections.topics
  size: 1
  alias: topic
  addAllPagesToCollections: true
permalink: "/blog/tag/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.label }} — Marketing Insights"
  description: "Explore AldaHub articles about {{ topic.label }}. Find practical guidance to connect marketing activity with clearer decisions and measurable business outcomes."
---
<section class="page-hero">
  <div class="container">
    <a class="text-link" href="/blog/">← All insights</a>
    <p class="eyebrow">Browse by topic</p>
    <h1>{{ topic.label }}</h1>
    <p class="lead">Explore {{ topic.posts | length }} {% if topic.posts | length == 1 %}article{% else %}articles{% endif %} on {{ topic.label }}. Put the ideas to work in your next marketing decision.</p>
  </div>
</section>
<section class="section" aria-labelledby="topic-articles-heading">
  <div class="container">
    <div class="section-heading">
      <h2 id="topic-articles-heading">Articles on {{ topic.label }}</h2>
      <p>Practical guidance from the AldaHub journal.</p>
    </div>
    <div class="cards">
      {% for post in topic.posts %}
      <article class="card article-card">
        {% if post.data.featured_image %}
        <a href="{{ post.url }}" class="article-card-image" tabindex="-1" aria-hidden="true">
          <img src="{{ post.data.featured_image }}" alt="" loading="lazy" decoding="async" width="800" height="450">
        </a>
        {% endif %}
        <div class="article-card-body">
          <p class="article-meta"><time datetime="{{ post.date | dateISO }}">{{ post.date | dateDisplay }}</time> <span aria-hidden="true">·</span> {{ post.data.author or 'AldaHub' }}</p>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description or post.templateContent | summary }}</p>
          <a class="text-link" href="{{ post.url }}">Read article <span class="sr-only">— {{ post.data.title }}</span><span aria-hidden="true"> ↗</span></a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% include "partials/audit-cta.njk" %}
