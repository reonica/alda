<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home"><img src="{{ site.logo }}" width="54" height="54" alt=""><span>{{ site.name }}<span class="brand-dot">.</span></span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" hidden><span class="nav-toggle-label">{{ navigation.menuLabel }}</span>{% icon "menu" %}</button>
    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      {% for item in navigation.items %}<a href="{{ item.url }}"{% if item.url | navActive(page.url) %} class="active"{% endif %}{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
      <a class="button button-small" href="{{ navigation.cta.url }}"{% if page.url == navigation.cta.url %} aria-current="page"{% endif %}>{{ navigation.cta.label }} <span aria-hidden="true">{% icon "arrow-up-right" %}</span></a>
    </nav>
  </div>
</header>
