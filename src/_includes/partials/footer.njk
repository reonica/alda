<footer class="site-footer">
  <div class="container footer-grid">
    <div><a class="brand footer-brand" href="/">{{ site.name }}.</a><p class="brand-slogan">{{ site.slogan }}</p><a class="text-link" href="{{ site.whatsapp }}" data-whatsapp target="_blank" rel="noopener noreferrer">{{ footer.whatsappLabel }} {% icon "arrow-up-right" %}</a></div>
    <nav aria-label="Footer navigation"><p class="eyebrow">{{ footer.navigationTitle }}</p>{% for item in footer.links %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</nav>
    <div><p class="eyebrow">{{ footer.newsletterTitle }}</p><p>{{ footer.newsletterDescription }}</p>
      <form name="newsletter" method="post" action="/thank-you/newsletter/" data-netlify="true" netlify-honeypot="bot-field" class="newsletter-form" data-lead-form>
        <input type="hidden" name="form-name" value="newsletter">
        <p class="honeypot"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <label for="newsletter-email">Email address</label><div class="newsletter-input"><input id="newsletter-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com"><button class="button" type="submit"{% if site.preview or not site.netlifyForms %} disabled{% endif %}>{{ footer.newsletterButton }} <span aria-hidden="true">{% icon "arrow-up-right" %}</span></button></div>
        <p class="form-note">By subscribing, you ask to receive marketing emails. <a href="/privacy/">Privacy details</a>.</p>
        <p class="form-status" role="status" aria-live="polite">{% if site.preview or not site.netlifyForms %}Preview: forms do not send here. Use the live website or WhatsApp to contact us.{% endif %}</p>
      </form>
    </div>
  </div>
  <div class="container footer-bottom"><p>© {{ site.year }} {{ site.name }}</p><p>{{ footer.bottomText }}</p><a href="/privacy/">Privacy</a></div>
</footer>
