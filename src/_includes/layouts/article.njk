---
layout: layouts/base.njk
---
<article class="section article">
  <header class="container article-header">
    <p class="eyebrow">Marketing insights</p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="lead">{{ description }}</p>{% endif %}
    <p class="article-meta">
      <span>By {{ author or 'AldaHub' }}</span>
      <span aria-hidden="true">·</span>
      <time datetime="{{ page.date | dateISO }}">{{ page.date | dateDisplay }}</time>
      {% if modified %}<span aria-hidden="true">·</span><span>Updated <time datetime="{{ modified | dateISO }}">{{ modified | dateDisplay }}</time></span>{% endif %}
      <span aria-hidden="true">·</span>
      <span>{{ content | readingTime }} min read</span>
    </p>
    {% if featured_image %}
    <img class="article-featured-image" src="{{ featured_image }}" alt="" width="1200" height="675" decoding="async" fetchpriority="high">
    {% endif %}
  </header>
  <div class="container article-body">
    <div class="prose">{{ content | safe }}</div>
    <footer class="article-footer">
      {% if tags | length %}
      <p class="eyebrow">Explore these topics</p>
      <p class="article-topics">
        {% for tag in tags %}<a class="tag" href="/blog/tag/{{ tag | topicSlug }}/">{{ tag }}</a> {% endfor %}
      </p>
      {% endif %}
      <a class="text-link" href="/blog/">{% icon "arrow-left" %} Explore more marketing insights</a>
    </footer>
  </div>
</article>
{% include "partials/audit-cta.njk" %}
