---
layout: layouts/base.njk
title: Marketing Insights & Resources
description: Practical guides to marketing analytics, SEO, AI search, social performance and conversion optimization. Turn what you learn into clearer growth decisions.
nav: resources
eleventyComputed:
  title: "Marketing Insights & Resources{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %}"
  description: "Practical guides to marketing analytics, SEO, AI search, social performance and conversion optimization.{% if pagination.pageNumber > 0 %} Archive page {{ pagination.pageNumber + 1 }}.{% endif %}"
pagination:
  data: collections.posts
  size: 6
  alias: posts
  addAllPagesToCollections: true
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">The AldaHub journal</p>
    <h1>Ideas for better marketing decisions.</h1>
    <p class="lead">Explore practical guides to understanding your audience, connecting your channels and measuring what moves your business forward.</p>
    <a class="text-link" href="/seo-roadmap/">Learning search marketing? Explore the SEO Roadmap {% icon "arrow-up-right" %}</a>
  </div>
</section>
<section class="section" aria-labelledby="articles-heading">
  <div class="container">
    <div class="section-heading">
      <h2 id="articles-heading">Latest insights{% if pagination.pageNumber > 0 %} · Page {{ pagination.pageNumber + 1 }}{% endif %}</h2>
      <p>{{ collections.posts | length }} articles on marketing, measurement and growth.</p>
    </div>
    <div class="cards">
      {% for post in posts %}
      <article class="card article-card">
        {% if post.data.featured_image %}
        <a href="{{ post.url }}" class="article-card-image" tabindex="-1" aria-hidden="true">
          <img src="{{ post.data.featured_image }}" alt="" loading="lazy" decoding="async" width="800" height="450">
        </a>
        {% endif %}
        <div class="article-card-body">
          <p class="article-meta"><time datetime="{{ post.date | dateISO }}">{{ post.date | dateDisplay }}</time> <span aria-hidden="true">·</span> {{ post.data.author or 'AldaHub' }}</p>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description or post.templateContent | summary }}</p>
          <a class="text-link" href="{{ post.url }}">Read article <span class="sr-only">— {{ post.data.title }}</span><span aria-hidden="true"> {% icon "arrow-up-right" %}</span></a>
        </div>
      </article>
      {% endfor %}
    </div>
    {% if pagination.hrefs | length > 1 %}
    <nav class="pagination" aria-label="Article pages">
      {% if pagination.href.previous %}<a class="button button-secondary" href="{{ pagination.href.previous }}" rel="prev">{% icon "arrow-left" %} Newer articles</a>{% endif %}
      <ol>
        {% for href in pagination.hrefs %}
        <li>{% if page.url == href %}<span aria-current="page" aria-label="Page {{ loop.index }}, current page">{{ loop.index }}</span>{% else %}<a href="{{ href }}" aria-label="Page {{ loop.index }}">{{ loop.index }}</a>{% endif %}</li>
        {% endfor %}
      </ol>
      {% if pagination.href.next %}<a class="button button-secondary" href="{{ pagination.href.next }}" rel="next">Older articles {% icon "arrow-right" %}</a>{% endif %}
    </nav>
    {% endif %}
  </div>
</section>
{% include "partials/audit-cta.njk" %}
